# Copy to .env and adjust. Everything here has a working default (see src/taobao_ctr/config.py)
# that depends on the detected platform (Kaggle / Colab / local) — set these only to override it.

# Where raw CSVs and temporary buckets are stored (fast local disk).
TAOBAO_DATA_DIR=./data

# Where caches, predictions, model files and reports are stored (should survive a restart).
TAOBAO_ARTIFACT_DIR=./artifacts

# params.yaml ("full") or params.synthetic.yaml merged on top ("synthetic"). Tests/CI use synthetic.
TAOBAO_PROFILE=synthetic

# MLflow tracking store.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Only needed when downloading the real dataset off Kaggle (kagglehub reads this automatically
# from ~/.kaggle/kaggle.json too — this is only a fallback for containers/CI).
# KAGGLE_USERNAME=
# KAGGLE_KEY=
